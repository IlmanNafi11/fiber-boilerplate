FROM golang:1.25-alpine

RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Cache dependency downloads
COPY go.mod go.sum ./
RUN go mod download

# Install Air for hot reload (CGO_ENABLED=0 — no C deps needed, avoids musl-dev requirement)
RUN CGO_ENABLED=0 go install github.com/air-verse/air@latest

EXPOSE 3000

CMD ["air"]
