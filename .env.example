# Application Configuration
APP_ENV=development
APP_PORT=3000
APP_NAME=your-app-name
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=30m
DB_MAX_CONN_LIFETIME=2h

# Authentication Configuration
# JWT_SECRET is required. Use a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-key
# JWT_SECRET_PREVIOUS is optional, used for graceful secret rotation
JWT_SECRET_PREVIOUS=
# Token TTLs (Go duration format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Grace period for concurrent refresh requests (prevents false reuse detection)
JWT_REFRESH_GRACE_PERIOD=30s
# Toggle registration endpoint (set to false to disable)
REGISTRATION_ENABLED=true
