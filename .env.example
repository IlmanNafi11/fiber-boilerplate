# Application Configuration
APP_ENV=development
APP_PORT=3000
APP_NAME=your-app-name
# ALLOWED_ORIGINS is a comma-separated list of allowed CORS origins.
# In production it MUST be non-empty and MUST NOT contain "*" (config fails closed).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=30m
DB_MAX_CONN_LIFETIME=2h

# Authentication Configuration
# JWT_SECRET is required. Use a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-key
# JWT_SECRET_PREVIOUS is optional, used for graceful secret rotation
JWT_SECRET_PREVIOUS=
# Token TTLs (Go duration format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Grace period for concurrent refresh requests (prevents false reuse detection)
JWT_REFRESH_GRACE_PERIOD=30s
# Toggle registration endpoint (set to false to disable)
REGISTRATION_ENABLED=true

# Rate Limiting Configuration
# All rate limits are disabled when set to 0 (omit or set to 0 to disable)
# Login rate limit (per IP+email)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m
# Forgot-password rate limit (per IP+email) — wired in Phase 6
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=15m
# Global API rate limit (per IP)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=1m

# Email Configuration
# Toggle email verification (set to false for internal services)
EMAIL_VERIFICATION_ENABLED=true
# Token TTLs (Go duration format)
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=15m

# Email Outbox Dispatcher (durable at-least-once delivery)
# Poll interval, batch size, and lease held while sending.
EMAIL_OUTBOX_DISPATCH_INTERVAL=5s
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_LEASE=2m
# Per-send timeout, max attempts before dead-lettering, and backoff bounds.
EMAIL_OUTBOX_SEND_TIMEOUT=10s
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_BASE_BACKOFF=10s
EMAIL_OUTBOX_MAX_BACKOFF=1h

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# Seeder Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# Docker Entrypoint Control
AUTO_MIGRATE=false
AUTO_SEED=false

# Swagger Configuration
# Toggle Swagger UI (defaults to true in development, false in production).
# A malformed value (not a boolean) makes config fail closed. Production rejects
# an enabled Swagger UI.
SWAGGER_ENABLED=true
